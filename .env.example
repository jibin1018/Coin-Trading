# 이 파일을 .env로 복사해서 실제 값을 채우세요. .env는 .gitignore에 의해 커밋되지 않습니다.
# cp .env.example .env

# ── 브로커/거래소 API 키 (원본 프로젝트, 이미 코드에서 사용 중) ──────────────

# 바이낸스 실계좌 키. 스팟+선물 공용, Trade 권한만 부여 (출금 권한 절대 금지)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# 한국투자증권 모의투자 Open API 키 (국장/미장 스윙봇용)
HANTOO_TEST_KEY=
HANTOO_TEST_SECRET=

# ── AI / 외부 데이터 연동 (개발 예정, 아직 코드에서 안 씀) ──────────────────

# 대시보드 챗봇·공시 분석용 LLM API 키
ANTHROPIC_API_KEY=

# 국내 공시 분석용 — opendart.fss.or.kr 에서 이메일로 무료 발급
DART_API_KEY=

# 미국 SEC EDGAR API 요청 헤더(User-Agent)에 넣을 연락처. 형식 예: "AppName contact@example.com"
SEC_EDGAR_CONTACT=

# AI 봇 통신용 OpenAI API 키 (Ollama 사용 시 'ollama'로 입력)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
